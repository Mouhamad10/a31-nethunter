# A31 (SM-A315F / MT6768) Kali NetHunter defconfig fragment
# Merge onto the booting 4.14 "Atrocious" a31_defconfig:
#   scripts/kconfig/merge_config.sh arch/arm64/configs/a31_defconfig a315f_nethunter_defconfig.fragment
# NOTE: confirm the EXACT MTU3 DT node (dr_mode=otg) and the A31 Type-C/TCPC symbol
# names in the Atrocious tree (arch/arm64/boot/dts + drivers/usb) before building.

# --- 802.11 stack (monitor + inject) ---
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_PACKET=y

# --- in-tree USB wifi adapters (external = the reliable inject path) ---
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=y
CONFIG_EEPROM_93CX6=y
CONFIG_RTL8192CU=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=y
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_ZD1211RW=y
CONFIG_USB_NET_RNDIS_WLAN=y

# --- out-of-tree Alfa chipsets (via kimocoder/nethunter_wireless_modules) ---
# Only ONE of 88XXAU / RTL8822BU may be =y inline; build the other =m.
# CONFIG_88XXAU=y        # rtl8812au (stronger injection)
CONFIG_RTL8822BU=m       # rtl8822bu (user's adapter; weak injector, build as module)
CONFIG_RTL8188EU=m       # rtl8188eus must be a module

# --- USB gadget / NetHunter arsenal ---
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_ACM=y

# --- USB host / OTG (enumerate external adapters) ---
CONFIG_USB=y
CONFIG_USB_OTG=y
CONFIG_USB_MTU3=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_MTK=y
CONFIG_TCPC_CLASS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y

# --- Bluetooth (NetHunter BT dongles) ---
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIVHCI=y

# --- module loading (modular .ko wifi drivers + MTK connectivity force-load) ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y

# --- root + virtualization (from Vexicle A32 reference) ---
CONFIG_KSU=y
CONFIG_KPROBES=y
CONFIG_KVM=y
CONFIG_VIRTUALIZATION=y

# --- OneOS/DSU container prereqs + tunneling ---
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_OVERLAY_FS=y
CONFIG_SECCOMP=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_TUN=y
CONFIG_PSI=y
CONFIG_SYSVIPC=y

# --- zram for 4GB (GSI phase) ---
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_WRITEBACK=y
