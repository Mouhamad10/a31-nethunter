# A31 (SM-A315F / MT6768) Kali NetHunter — SURGICAL wifi/monitor fragment.
# Appended to the running Atrocious 4.14 config. Adds ONLY the 802.11 softmac
# stack + in-tree USB wifi drivers (monitor mode + injection via external adapter).
# Deliberately does NOT touch USB host / OTG / MTU3 / XHCI / TCPC: host mode is
# ALREADY working on-device via the MediaTek musb controller, and changing those
# symbols risks breaking a known-good boot. Out-of-tree drivers (RTL8822BU Archer
# T4U, RTL8812AU) are a separate step — their source is not in the 4.14 tree.

# --- 802.11 softmac stack (monitor + inject) ---
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_PACKET=y
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PRIV=y
CONFIG_WEXT_PROC=y

# --- in-tree USB wifi adapters (external = the reliable inject path) ---
# RTL8187 = the user's "Signal Max" (primary target)
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=y
CONFIG_EEPROM_93CX6=y
CONFIG_RTL8192CU=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
# broad in-tree coverage so most common adapters just work
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=y
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_ZD1211RW=y
CONFIG_USB_NET_RNDIS_WLAN=y

# --- Bluetooth USB (NetHunter BT dongles) ---
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIVHCI=y

# --- USB gadget HID (NetHunter HID / BadUSB keyboard attacks) ---
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
